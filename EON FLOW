</div>
<script>
(() => {
  const $ = id => document.getElementById(id);
  const fmt = (n, digits=2) => Number.isFinite(Number(n)) ? Number(n).toLocaleString('en-US',{minimumFractionDigits:digits,maximumFractionDigits:digits}) : '—';
  const compact = n => Number(n||0).toLocaleString('en-US',{maximumFractionDigits:4});
  let symbol='BTCUSDT', interval='1m', sockets=[], tradeCount=0, latestPrice=0, dailyChange=0, candles=[], footprint=new Map(), candleMinute=null, chart, candleSeries;
  const recent=[];
  const precision = s => ({BTCUSDT:1,ETHUSDT:0.1,SOLUSDT:0.01,BNBUSDT:0.1,XRPUSDT:0.0001}[s] || 0.01);
  const priceDigits = s => ({BTCUSDT:2,ETHUSDT:2,SOLUSDT:3,BNBUSDT:2,XRPUSDT:5}[s] || 2);
  const fmtPrice = n => fmt(n, priceDigits(symbol));
  function initChart(){
    chart = LightweightCharts.createChart($('chart'), {
      layout:{background:{type:'solid',color:'#08121f'},textColor:'#8da4c1',fontFamily:'Inter, sans-serif',fontSize:11},
      grid:{vertLines:{color:'#112338'},horzLines:{color:'#112338'}},
      rightPriceScale:{borderColor:'#20344a'},timeScale:{borderColor:'#20344a',timeVisible:true,secondsVisible:false},
      crosshair:{mode:0},handleScroll:true,handleScale:true
    });
    candleSeries=chart.addCandlestickSeries({upColor:'#00d6a0',downColor:'#ff5268',borderUpColor:'#00d6a0',borderDownColor:'#ff5268',wickUpColor:'#00d6a0',wickDownColor:'#ff5268'});
    new ResizeObserver(()=>chart.applyOptions({width:$('chart').clientWidth,height:$('chart').clientHeight})).observe($('chart'));
  }
  function closeSockets(){sockets.forEach(s=>{try{s.close()}catch(e){}});sockets=[]}
  function connect(){
    closeSockets(); footprint.clear(); candleMinute=null; recent.length=0; tradeCount=0;
    $('footprint').innerHTML='<div class="sub" style="padding:20px">Waiting for live trades…</div>';
    $('recentTrades').innerHTML=''; $('asks').innerHTML=''; $('bids').innerHTML='';
    $('liveStatus').textContent='Connecting…'; $('feedStatus').textContent='Connecting to Binance…'; $('feedStatus').className='';
    $('marketLabel').textContent=symbol.slice(0,-4)+' / USDT · LIVE'; $('chartSymbol').textContent=symbol;
    if(chart){candleSeries.setData([])}
    loadHistory();
    const streams=[`${symbol.toLowerCase()}@aggTrade`,`${symbol.toLowerCase()}@depth20@100ms`,`${symbol.toLowerCase()}@ticker`,`${symbol.toLowerCase()}@kline_${interval}`];
    streams.forEach(stream=>{
      const ws=new WebSocket(`wss://stream.binance.com:9443/ws/${stream}`); sockets.push(ws);
      ws.onopen=()=>{ $('liveStatus').textContent='Live Market'; $('feedStatus').textContent='Connected · Binance Spot'; $('feedStatus').className='statusconnected'; };
      ws.onmessage=e=>{try{const d=JSON.parse(e.data);if(d.e==='aggTrade')onTrade(d);else if(d.e==='depthUpdate')onDepth(d);else if(d.e==='24hrTicker')onTicker(d);else if(d.e==='kline')onKline(d.k)}catch(err){}};
      ws.onerror=()=>{$('feedStatus').textContent='Connection issue · retrying';$('feedStatus').className='statuserror';};
      ws.onclose=()=>{if(symbol===streams[0].slice(0,-9).toUpperCase()){$('liveStatus').textContent='Reconnecting…'}};
    });
  }
  async function loadHistory(){
    const thisSymbol=symbol, thisInterval=interval;
    try{
      const r=await fetch(`https://api.binance.com/api/v3/klines?symbol=${thisSymbol}&interval=${thisInterval}&limit=300`);
      if(!r.ok)throw new Error('HTTP '+r.status);
      const data=await r.json(); if(thisSymbol!==symbol||thisInterval!==interval)return;
      const rows=data.map(k=>({time:Math.floor(k[0]/1000),open:+k[1],high:+k[2],low:+k[3],close:+k[4]}));
      candleSeries.setData(rows); candles=rows; chart.timeScale().fitContent();
    }catch(e){$('feedStatus').textContent='Chart history unavailable; waiting for stream';$('feedStatus').className='statuserror'}
  }
  function onTrade(d){
    tradeCount++; const p=+d.p, q=+d.q, minute=Math.floor(d.T/60000)*60;
    latestPrice=p;
    if(candleMinute!==minute){candleMinute=minute;footprint.clear()}
    const step=precision(symbol), level=Math.round(p/step)*step, key=level.toFixed(priceDigits(symbol));
    if(!footprint.has(key))footprint.set(key,{price:level,bid:0,ask:0});
    const row=footprint.get(key);
    // Binance m=true means buyer was maker, so the aggressive taker was selling.
    if(d.m)row.bid+=q;else row.ask+=q;
    recent.unshift({p,q,buy:!d.m,t:d.T});if(recent.length>35)recent.pop();
    $('lastPrice').textContent=fmtPrice(p);renderFootprint();renderTrades();$('tradeCount').textContent='Trades received: '+tradeCount.toLocaleString();
  }
  function onTicker(d){
    $('high').textContent=fmt(+d.h,priceDigits(symbol));$('low').textContent=fmt(+d.l,priceDigits(symbol));$('volume').textContent=compact(+d.v);
    dailyChange=+d.P;$('change').textContent=(dailyChange>=0?'+':'')+fmt(dailyChange,2)+'%';
    $('change').className=dailyChange>=0?'metricvalue green':'metricvalue red';
    $('priceChange').textContent=(dailyChange>=0?'+':'')+fmt(+d.p,priceDigits(symbol))+' ('+fmt(dailyChange,2)+'% 24h)';
    $('priceChange').className=dailyChange>=0?'green':'red';
  }
  function onKline(k){
    const bar={time:Math.floor(k.t/1000),open:+k.o,high:+k.h,low:+k.l,close:+k.c};
    candleSeries.update(bar);latestPrice=bar.close;
  }
  function onDepth(d){
    const asks=d.a.map(x=>({p:+x[0],q:+x[1]})).filter(x=>x.q>0).sort((a,b)=>a.p-b.p).slice(0,10).reverse();
    const bids=d.b.map(x=>({p:+x[0],q:+x[1]})).filter(x=>x.q>0).sort((a,b)=>b.p-a.p).slice(0,10);
    $('asks').innerHTML=asks.map(x=>`<div class="depthrow ask"><span>${fmtPrice(x.p)}</span><span>${compact(x.q)}</span><span>${compact(x.p*x.q)}</span></div>`).join('');
    $('bids').innerHTML=bids.map(x=>`<div class="depthrow bid"><span>${fmtPrice(x.p)}</span><span>${compact(x.q)}</span><span>${compact(x.p*x.q)}</span></div>`).join('');
    if(asks.length&&bids.length)$('midPrice').innerHTML=`<span class="muted" style="font-size:10px">SPREAD ${(asks[asks.length-1].p-bids[0].p).toFixed(priceDigits(symbol))}</span><br>${fmtPrice((asks[asks.length-1].p+bids[0].p)/2)}`;
  }
  function renderFootprint(){
    const rows=[...footprint.values()].sort((a,b)=>b.price-a.price);
    if(!rows.length)return;
    const max=Math.max(1,...rows.map(r=>Math.max(r.bid,r.ask)));
    let sell=0,buy=0;
    $('footprint').innerHTML=rows.slice(0,70).map(r=>{
      sell+=r.bid;buy+=r.ask;const delta=r.ask-r.bid;
      const sb=Math.round(10+70*r.bid/max),bb=Math.round(10+70*r.ask/max);
      return `<div class="footrow"><div class="sellvol" style="background:rgba(255,62,94,${.10+.48*r.bid/max})">${compact(r.bid)}</div><div class="buyvol" style="background:rgba(0,214,160,${.10+.48*r.ask/max})">${compact(r.ask)}</div><div class="imbalance ${delta>=0?'green':'red'}">${delta>=0?'+':''}${compact(delta)}</div><div class="fpprice" style="grid-column:1/-1;display:none">${fmtPrice(r.price)}</div><div style="grid-column:1/-1;height:1px;background:#112237;position:relative"><span style="position:absolute;left:0;top:-15px;background:#0a1625;color:#8da4c1;padding:0 3px;font-size:9px">${fmtPrice(r.price)}</span></div></div>`;
    }).join('');
    $('sellTotal').textContent=compact(sell);$('buyTotal').textContent=compact(buy);
    $('deltaTotal').textContent=(buy-sell>=0?'+':'')+compact(buy-sell);$('deltaTotal').className=buy>=sell?'green':'red';
    $('footMeta').textContent=`${rows.length} price levels · current minute`;
  }
  function renderTrades(){
    $('recentTrades').innerHTML=recent.map(t=>`<div class="traderow"><span class="${t.buy?'green':'red'}">${fmtPrice(t.p)}</span><span>${compact(t.q)}</span><span class="${t.buy?'green':'red'}">${t.buy?'BUY':'SELL'} · ${new Date(t.t).toLocaleTimeString()}</span></div>`).join('');
  }
  function renderWatchlist(){
    const syms=['BTCUSDT','ETHUSDT','SOLUSDT','BNBUSDT','XRPUSDT'];
    $('watchlist').innerHTML=syms.map(s=>`<div class="watchrow ${s===symbol?'selected':''}" data-symbol="${s}"><div><div class="sym">${s.slice(0,-4)}</div><div class="sub">/ USDT · Spot</div></div><div style="text-align:right"><div>${s===symbol&&latestPrice?fmt(latestPrice,priceDigits(s)):'Live'}</div><div class="sub">Binance</div></div></div>`).join('');
    document.querySelectorAll('.watchrow').forEach(el=>el.onclick=()=>{symbol=el.dataset.symbol;$('symbolSelect').value=symbol;renderWatchlist();connect()});
  }
  $('symbolSelect').addEventListener('change',e=>{symbol=e.target.value;renderWatchlist();connect()});
  document.querySelectorAll('[data-interval]').forEach(b=>b.addEventListener('click',()=>{interval=b.dataset.interval;document.querySelectorAll('[data-interval]').forEach(x=>x.classList.toggle('on',x===b));connect()}));
  setInterval(()=>$('clock').textContent=new Date().toLocaleTimeString()+' LOCAL',1000);
  initChart();renderWatchlist();connect();
})();
</script>
</body>
</html>

# MMT Flow — Live Order Flow Terminal

A GitHub Pages-ready, read-only crypto market dashboard with live Binance Spot data.

## Features
- Live price and 24-hour ticker stats
- Candlestick chart with 1m, 5m, 15m, and 1h intervals
- Live top-of-book depth snapshot (top 10 asks and bids displayed)
- Live trades feed
- Live footprint approximation aggregated from Binance `aggTrade` events for the current minute
- BTC, ETH, SOL, BNB, XRP USDT markets
- Responsive dark interface

## Run locally
Open `index.html` in a modern browser, or use VS Code Live Server. Internet access is required.

## Publish with GitHub Pages
1. Create a GitHub repository, e.g. `mmt-flow`.
2. Upload `index.html` and this README.
3. In repository settings, open **Pages**.
4. Choose **Deploy from a branch**, select `main` and `/ (root)`, then save.
5. Wait for the published URL shown in the Pages section.

## Data notes
- Uses Binance public Spot REST and WebSocket endpoints; no API key is needed.
- A network, browser extension, regional restriction, or exchange outage can block live data.
- The footprint is calculated from trades received after connection. It does not include historical bid/ask footprint data.
- Binance `aggTrade` maker flag is used to infer aggressor side: buyer-is-maker = sell aggressor; otherwise buy aggressor.
- The DOM is a displayed top-of-book depth snapshot stream, not a full exchange order-book reconstruction.
- This project does not place orders, hold funds, connect to accounts, or request API secrets.
- It is an analytics interface, not financial advice.
