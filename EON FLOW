<aside>
  <div class="nav active">▦ &nbsp; Trading Terminal</div><div class="nav">◉ &nbsp; Order Flow</div><div class="nav">▤ &nbsp; Footprint</div><div class="nav">▥ &nbsp; Liquidity / DOM</div>
