.depth{max-height:370px;overflow:auto}.depthhead,.depthrow{display:grid;grid-template-columns:1fr 1fr 1fr;gap:6px;padding:6px 12px;font-variant-numeric:tabular-nums}.depthhead{color:var(--muted);font-size:10px;border-bottom:1px solid var(--line)}.depthrow span:nth-child(2){text-align:center}.depthrow span:last-child{text-align:right}.ask{color:#ff7687;background:linear-gradient(90deg,transparent,#3a1824)}.bid{color:#36e3b0;background:linear-gradient(90deg,transparent,#10392f)}.midprice{text-align:center;padding:12px;font-weight:800;font-size:17px;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.tradehead{display:flex;gap:8px;align-items:center}.tradehead select{padding:6px 8px}
.trades{max-height:250px;overflow:auto}.traderow{display:grid;grid-template-columns:1fr 1fr 1fr;padding:7px 12px;border-bottom:1px solid #112136;font-variant-numeric:tabular-nums}.traderow span:nth-child(2){text-align:center}.traderow span:last-child{text-align:right}
.statusbar{margin-top:12px;padding:10px 12px;display:flex;justify-content:space-between;gap:12px;color:var(--muted);border:1px solid var(--line);border-radius:8px;background:#081321}.statusconnected{color:var(--green)}.statuserror{color:var(--red)}.disclaimer{color:#7186a0;font-size:10px;line-height:1.6;margin-top:9px}
@media(max-width:1050px){.layout{grid-template-columns:160px minmax(0,1fr)}.workspace{grid-template-columns:1fr}.ticker{grid-template-columns:repeat(3,1fr)}.lower{grid-template-columns:1fr}}
@media(max-width:650px){.topbar{padding:0 12px}.topright .clock{display:none}.layout{display:block}aside{display:none}main{padding:8px}.ticker{grid-template-columns:repeat(2,1fr)}.pricebig{font-size:18px}#chart{height:300px}.workspace{grid-template-columns:minmax(0,1fr)}}
